# Server-side only. Never expose this as a VITE_ variable.
# Production retailer discovery and cloud job continuation signing.
OCTOPARSE_API_KEY=replace_with_your_octoparse_key
# Legacy adapters below are retained for regression tests, not production search.
BRIGHTDATA_API_KEY=replace_with_your_brightdata_key
BRIGHTDATA_SERP_ZONE=shopnearme_serp_api
# Optional Web Unlocker zone for blocked merchant pages (max 3 reads per search).
BRIGHTDATA_PRODUCT_ZONE=
EBAY_CLIENT_ID=replace_with_your_ebay_app_id
EBAY_CLIENT_SECRET=replace_with_your_ebay_cert_id
